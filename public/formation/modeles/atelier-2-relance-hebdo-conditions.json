      {
       "keyName": "statut",
       "condition": "eq",
       "keyValue": "Nouveau"
      }
     ]
    },
    "returnAll": true,
    "options": {}
   }
  },
  {
   "id": "6430dc73-5507-4774-a22d-0b24b8cd96c7",
   "name": "Budget ≥ 1 000 € ?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    480,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "4fc7fbdb-32e5-4b74-9231-88a62aa724be",
       "leftValue": "={{ $json.budget }}",
       "rightValue": 1000,
       "operator": {
        "type": "number",
        "operation": "gte"
       }
      }
     ],
     "combinator": "and"
    },
    "looseTypeValidation": true,
    "options": {}
   }
  },
  {
   "id": "d321c67f-542c-4c40-89ac-14515129fcc1",
